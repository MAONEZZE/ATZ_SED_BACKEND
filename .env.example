# Database
DATABASE_URL="postgresql://sed:sed@localhost:5432/sed?schema=ATZ_SED&pgbouncer=true"
DIRECT_URL="postgresql://sed:sed@localhost:5432/sed?schema=ATZ_SED"

# Redis
REDIS_URL="redis://localhost:6379"

# Supabase
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="event-covers"
SUPABASE_STORAGE_BUCKET_COVERS="event-covers"
SUPABASE_STORAGE_BUCKET_UPLOADS="registration-uploads"
SUPABASE_STORAGE_BUCKET_PROFILE_PHOTOS="profile-photos"

# External APIs
# Uazapi — URL base do servidor de WhatsApp (o token é por instância, no banco)
UAZAPI_API_URL="https://free.uazapi.com"
# Uazapi — secret compartilhado que valida os webhooks de status recebidos
UAZAPI_WEBHOOK_SECRET="change-me"
# URL pública desta app (base para montar a URL do webhook registrado na Uazapi)
APP_PUBLIC_URL="https://api.yourdomain.com"
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
PIPEDRIVE_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/pipedrive"

# App
PORT=3000
BODY_LIMIT="5mb"
NODE_ENV=development
ENVIROMENT=development

# WhatsApp — espaçamento anti-ban entre contatos (ms)
# ~25s de média. Chip novo/frio: subir para 40000/60000
WA_MIN_DELAY_MS=15000
WA_MAX_DELAY_MS=35000
WA_AUTOMATION_GAP_MIN_MS=15000
WA_AUTOMATION_GAP_MAX_MS=35000
WA_DISPATCH_CONCURRENCY=1
# Hardening de pacing no dispatch (manual pelo cursor compartilhado + re-pacing no retry).
# false = comportamento legado. Ligar após validar em staging.
DISPATCH_GATE_ENABLED=false

# WhatsApp — simulação de digitação (typing) via delay do envio
WA_TYPING_ENABLED=true
WA_TYPING_MIN_MS=1500
WA_TYPING_MAX_MS=4000
WA_TYPING_MS_PER_CHAR=40
WA_TYPING_MAX_TOTAL_MS=15000

# Envio manual em lote — gap entre lotes 5–10min (chip novo: 1800000/3600000)
MANUAL_BATCH_SIZE=20
MANUAL_BATCH_MIN_DELAY_MS=300000
MANUAL_BATCH_MAX_DELAY_MS=600000

# Workers / filas
SCHEDULED_AUTOMATIONS_INTERVAL_MS=60000
QUEUE_STALLED_INTERVAL_MS=600000
REDIS_CLEANUP_CRON="0 4 * * *"
