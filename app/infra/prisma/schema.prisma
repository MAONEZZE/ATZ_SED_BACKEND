generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["SED"]
}

// ==================== ENUMS ====================

enum EventStatus {
  draft
  published
  cancelled
  ended

  @@schema("SED")
}

enum FunnelStatus {
  pending
  approved
  rejected

  @@schema("SED")
}

enum FormFieldKind {
  registration
  post_event
  nps

  @@schema("SED")
}

enum FieldType {
  text
  textarea
  email
  phone
  select
  multiselect
  checkbox
  image
  date
  linkedin
  instagram

  @@schema("SED")
}

enum MessageChannel {
  whatsapp
  email

  @@schema("SED")
}

enum AutomationTrigger {
  on_registration
  on_post_event
  on_nps
  on_approval
  on_rejection
  recurring

  @@schema("SED")
}

enum OutboxStatus {
  pending
  processing
  sent
  failed

  @@schema("SED")
}

enum PipedriveStatus {
  pending
  sent
  failed
  skipped

  @@schema("SED")
}

// ==================== MODELS ====================

model Profile {
  id             String              @id @default(uuid())
  userId         String              @unique @map("user_id")
  name           String
  email          String
  photoUrl       String?             @map("photo_url")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  events         Event[]             @relation("EventOwner")
  editedEvents   Event[]             @relation("EventLastEditor")
  collaborations EventCollaborator[]
  templates      MessageTemplate[]
  outboxMessages OutboxMessage[]
  messageLogs    MessageLog[]        @relation("MessageLogOwner")
  folders        Folder[]
  allowedWhatsappInstances ProfileWhatsappInstance[]

  @@map("profiles")
  @@schema("SED")
}

model Event {
  id                 String              @id @default(uuid())
  ownerId            String              @map("owner_id")
  title              String
  slug               String              @unique
  coverUrl           String?             @map("cover_url")
  location           String?
  capacity           Int?
  dressCode          String?             @map("dress_code")
  groupLink          String?             @map("group_link")
  eventDate          DateTime?           @map("event_date")
  endDate            DateTime?           @map("end_date")
  sendToPipedrive    Boolean             @default(false) @map("send_to_pipedrive")
  recurrenceFreq     String?             @map("recurrence_freq")
  recurrenceInterval Int?                @map("recurrence_interval")
  recurrenceUntil    DateTime?           @map("recurrence_until")
  status             EventStatus         @default(draft)
  whatsappInstanceId String?             @map("whatsapp_instance_id")
  whatsappToken      String?             @map("whatsapp_token")
  folderId           String?             @map("folder_id")
  order              Int                 @default(0)
  lastEditedById     String?             @map("last_edited_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  owner              Profile             @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lastEditedBy       Profile?            @relation("EventLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  whatsappInstance   WhatsappInstance?   @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  folder             Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  collaborators      EventCollaborator[]
  forms              Form[]
  registrations      Registration[]
  postEventResponses PostEventResponse[]
  automationRules    AutomationRule[]
  outboxMessages     OutboxMessage[]
  messageLogs        MessageLog[]
  userSubscriptions  UserSubscription[]
  messageTemplates   MessageTemplate[]

  @@index([ownerId])
  @@index([whatsappInstanceId])
  @@index([folderId])
  @@map("events")
  @@schema("SED")
}

/// Pasta de organização dos eventos no painel. Aninhável (`parentId`) e ordenável
/// (`order`, dentro do irmão). Deletar a pasta não deleta evento: a FK dos
/// eventos é SetNull, e as subpastas são promovidas ao pai pelo repositório.
model Folder {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  name      String
  parentId  String?  @map("parent_id")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner     Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderTree")
  events    Event[]

  @@index([ownerId])
  @@index([parentId])
  @@map("folders")
  @@schema("SED")
}

model WhatsappInstance {
  id            String                     @id @default(uuid())
  name          String                     @unique
  nickname      String
  token         String?                    @map("token")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  events        Event[]
  allowedProfiles ProfileWhatsappInstance[]

  @@map("whatsapp_instances")
  @@schema("SED")
}

/// Lista de instâncias que um perfil PODE usar (N por perfil, ninguém é dono de
/// instância). Fixa: populada e ajustada só por SQL direto, sem rota de escrita.
/// Perfil sem nenhuma linha não dispara WhatsApp.
model ProfileWhatsappInstance {
  profileId  String           @map("profile_id")
  instanceId String           @map("instance_id")
  createdAt  DateTime         @default(now()) @map("created_at")
  profile    Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([profileId, instanceId])
  @@index([instanceId])
  @@map("profile_whatsapp_instances")
  @@schema("SED")
}

model Form {
  id                        String        @id @default(uuid())
  eventId                   String        @map("event_id")
  kind                      FormFieldKind @default(registration)
  description               String?
  postRegistrationMessage   String?       @map("post_registration_message")
  linkPostSubscription      String?       @map("link_post_subscription")
  requireImageAuthorization Boolean       @default(false) @map("require_image_authorization")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  event                     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields                    FormField[]

  @@unique([eventId, kind])
  @@map("forms")
  @@schema("SED")
}

model EventCollaborator {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  profileId String   @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([eventId, profileId])
  @@index([profileId])
  @@map("event_collaborators")
  @@schema("SED")
}

model FormField {
  id        String    @id @default(uuid())
  formId    String    @map("form_id")
  label     String
  type      FieldType
  required  Boolean   @default(true)
  options   Json?
  order     Int       @default(0)
  isFixed   Boolean   @default(false) @map("is_fixed")
  createdAt DateTime  @default(now()) @map("created_at")
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
  @@schema("SED")
}

model Registration {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  status             FunnelStatus       @default(pending)
  answers            Json
  name               String
  email              String
  phone              String
  imageAuthorization Boolean            @default(false) @map("image_authorization")
  attended           Boolean            @default(false)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  outboxMessages     OutboxMessage[]
  messageLogs        MessageLog[]
  postEventResponse  PostEventResponse?

  @@index([eventId, status])
  @@map("registrations")
  @@schema("SED")
}

model PostEventResponse {
  id             String       @id @default(uuid())
  eventId        String       @map("event_id")
  registrationId String       @map("registration_id")
  answers        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId])
  @@index([eventId])
  @@map("post_event_responses")
  @@schema("SED")
}

model UserSubscription {
  id                  String           @id @default(uuid())
  eventId             String           @map("event_id")
  name                String?
  email               String?
  phone               String?
  registrationAnswers Json?            @map("registration_answers")
  postEventAnswers    Json?            @map("post_event_answers")
  npsAnswers          Json?            @map("nps_answers")
  sendToPipedrive     Boolean          @default(false) @map("send_to_pipedrive")
  pipedriveStatus     PipedriveStatus? @map("pipedrive_status")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  event               Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, email])
  @@index([eventId, phone])
  @@map("user_subscriptions")
  @@schema("SED")
}

model MessageTemplate {
  id              String           @id @default(uuid())
  ownerId         String           @map("owner_id")
  name            String
  channel         MessageChannel
  subject         String?
  body            String
  layoutConfig    Json?            @map("layout_config")
  styleKey        String?          @map("style_key")
  eventId         String?          @map("event_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  automationRules AutomationRule[]
  outboxMessages  OutboxMessage[]

  @@index([ownerId])
  @@index([eventId])
  @@map("message_templates")
  @@schema("SED")
}

model AutomationRule {
  id           String            @id @default(uuid())
  eventId      String            @map("event_id")
  templateId   String            @map("template_id")
  trigger      AutomationTrigger
  delayMinutes Int?              @map("delay_minutes")
  cron         String?
  timezone     String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template     MessageTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([eventId, trigger, active])
  @@map("automation_rules")
  @@schema("SED")
}

model OutboxMessage {
  id                String           @id @default(uuid())
  eventId           String?          @map("event_id")
  ownerId           String?          @map("owner_id")
  registrationId    String?          @map("registration_id")
  templateId        String?          @map("template_id")
  trigger           String
  dedupKey          String           @unique @map("dedup_key")
  channel           MessageChannel
  recipient         String
  instancia         String?
  renderedBody      String           @map("rendered_body")
  renderedSubject   String?          @map("rendered_subject")
  inviteConfig      Json?            @map("invite_config")
  status            OutboxStatus     @default(pending)
  attempts          Int              @default(0)
  sentParts         Int              @default(0) @map("sent_parts")
  attachments       Json?            @map("attachments")
  sentAttachments   Int              @default(0) @map("sent_attachments")
  errorMessage      String?          @map("error_message")
  providerMessageId String?          @map("provider_message_id")
  deliveredAt       DateTime?        @map("delivered_at")
  readAt            DateTime?        @map("read_at")
  processedAt       DateTime?        @map("processed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  registration      Registration?    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template          MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  event             Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner             Profile?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([instancia, status])
  @@index([status, createdAt])
  @@index([eventId])
  @@index([ownerId])
  @@index([providerMessageId])
  @@map("outbox_messages")
  @@schema("SED")
}

model MessageLog {
  id                String         @id @default(uuid())
  eventId           String?        @map("event_id")
  ownerId           String?        @map("owner_id")
  registrationId    String?        @map("registration_id")
  channel           MessageChannel
  recipient         String
  body              String
  status            String
  errorMessage      String?        @map("error_message")
  providerMessageId String?        @map("provider_message_id")
  deliveredAt       DateTime?      @map("delivered_at")
  readAt            DateTime?      @map("read_at")
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  registration      Registration?  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event             Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner             Profile?       @relation("MessageLogOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([eventId])
  @@index([ownerId])
  @@index([providerMessageId])
  @@map("message_logs")
  @@schema("SED")
}
