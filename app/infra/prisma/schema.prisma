generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["SED"]
}

// ==================== ENUMS ====================

enum EventStatus {
  draft
  published
  cancelled
  ended

  @@schema("SED")
}

/// Papel de um colaborador dentro do evento. Ordem de poder: read < invited < admin.
/// O dono do evento é admin implícito (não tem linha em event_collaborators).
enum EventRole {
  admin
  invited
  read

  @@schema("SED")
}

/// Que tipo de registro uma pasta organiza. Uma pasta serve a UM tipo só — não
/// existe pasta mista (evento e template na mesma).
enum FolderResourceType {
  event
  message_template
  automation_rule

  @@schema("SED")
}

enum FunnelStatus {
  pending
  approved
  rejected

  @@schema("SED")
}

enum FieldType {
  text
  textarea
  email
  phone
  select
  multiselect
  checkbox
  image
  date
  linkedin
  instagram

  @@schema("SED")
}

enum MessageChannel {
  whatsapp
  email

  @@schema("SED")
}

enum AutomationTrigger {
  on_registration
  on_post_event
  on_nps
  on_approval
  on_rejection
  recurring
  on_form_submitted
  on_date

  @@schema("SED")
}

enum OutboxStatus {
  pending
  processing
  sent
  failed

  @@schema("SED")
}

enum PipedriveStatus {
  pending
  sent
  failed
  skipped

  @@schema("SED")
}

// ==================== MODELS ====================

model Profile {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique @map("user_id")
  name                     String
  email                    String
  photoUrl                 String?                   @map("photo_url")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  events                   Event[]                   @relation("EventOwner")
  editedEvents             Event[]                   @relation("EventLastEditor")
  collaborations           EventCollaborator[]
  templates                MessageTemplate[]
  outboxMessages           OutboxMessage[]
  messageLogs              MessageLog[]              @relation("MessageLogOwner")
  folders                  Folder[]
  allowedWhatsappInstances ProfileWhatsappInstance[]

  @@map("profiles")
  @@schema("SED")
}

model Event {
  id                 String              @id @default(uuid())
  ownerId            String              @map("owner_id")
  title              String
  slug               String              @unique
  coverUrl           String?             @map("cover_url")
  location           String?
  capacity           Int?
  dressCode          String?             @map("dress_code")
  groupLink          String?             @map("group_link")
  eventDate          DateTime?           @map("event_date")
  endDate            DateTime?           @map("end_date")
  sendToPipedrive    Boolean             @default(false) @map("send_to_pipedrive")
  recurrenceFreq     String?             @map("recurrence_freq")
  recurrenceInterval Int?                @map("recurrence_interval")
  recurrenceUntil    DateTime?           @map("recurrence_until")
  status             EventStatus         @default(draft)
  whatsappInstanceId String?             @map("whatsapp_instance_id")
  whatsappToken      String?             @map("whatsapp_token")
  folderId           String?             @map("folder_id")
  order              Int                 @default(0)
  lastEditedById     String?             @map("last_edited_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  owner              Profile             @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lastEditedBy       Profile?            @relation("EventLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  whatsappInstance   WhatsappInstance?   @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  folder             Folder?             @relation("EventInFolder", fields: [folderId], references: [id], onDelete: SetNull)
  folders            Folder[]            @relation("FolderInEvent")
  collaborators      EventCollaborator[]
  forms              Form[]
  registrations      Registration[]
  formResponses      FormResponse[]
  automationRules    AutomationRule[]
  outboxMessages     OutboxMessage[]
  messageLogs        MessageLog[]
  messageTemplates   MessageTemplate[]

  @@index([ownerId])
  @@index([whatsappInstanceId])
  @@index([folderId])
  @@map("events")
  @@schema("SED")
}

/// Pasta de organização do painel. Aninhável (`parentId`) e ordenável (`order`,
/// dentro do irmão). Dois eixos de escopo:
///
///   * `resourceType` — que tipo de registro ela organiza. Uma pasta serve a um
///     tipo só; não há consulta que atravesse tipos.
///   * `eventId` — `null` significa pasta do painel do dono (filtra por
///     `ownerId`); preenchido significa que a pasta vive DENTRO do evento e
///     acompanha o evento no compartilhamento, em vez de ficar presa ao perfil
///     que a criou. Aí `ownerId` é só "quem criou" e quem autoriza escrita é o
///     papel no evento.
///
/// A combinação válida de tipo x escopo é travada por CHECK no banco
/// (`folders_event_scope_check`, não modelado pelo Prisma) e validada no
/// service: `event` nunca dentro de evento, `automation_rule` sempre dentro.
///
/// Deletar a pasta não deleta o registro: as FKs `folder_id` são SetNull, e as
/// subpastas são promovidas ao pai pelo repositório.
model Folder {
  id               String             @id @default(uuid())
  ownerId          String             @map("owner_id")
  resourceType     FolderResourceType @default(event) @map("resource_type")
  eventId          String?            @map("event_id")
  name             String
  parentId         String?            @map("parent_id")
  order            Int                @default(0)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  owner            Profile            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event            Event?             @relation("FolderInEvent", fields: [eventId], references: [id], onDelete: Cascade)
  parent           Folder?            @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Folder[]           @relation("FolderTree")
  events           Event[]            @relation("EventInFolder")
  messageTemplates MessageTemplate[]
  automationRules  AutomationRule[]

  @@index([ownerId])
  @@index([parentId])
  @@index([eventId])
  @@index([ownerId, resourceType])
  @@map("folders")
  @@schema("SED")
}

model WhatsappInstance {
  id              String                    @id @default(uuid())
  name            String                    @unique
  nickname        String
  token           String?                   @map("token")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  events          Event[]
  allowedProfiles ProfileWhatsappInstance[]

  @@map("whatsapp_instances")
  @@schema("SED")
}

/// Lista de instâncias que um perfil PODE usar (N por perfil, ninguém é dono de
/// instância). Fixa: populada e ajustada só por SQL direto, sem rota de escrita.
/// Perfil sem nenhuma linha não dispara WhatsApp.
model ProfileWhatsappInstance {
  profileId  String           @map("profile_id")
  instanceId String           @map("instance_id")
  createdAt  DateTime         @default(now()) @map("created_at")
  profile    Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([profileId, instanceId])
  @@index([instanceId])
  @@map("profile_whatsapp_instances")
  @@schema("SED")
}

/// Formulário do evento. Um evento tem N formulários (o `kind` fixo
/// registration/post_event/nps morreu em 2026-08-17); `slug` é a chave pública
/// dentro do evento e `order` posiciona na listagem.
model Form {
  id                        String               @id @default(uuid())
  eventId                   String               @map("event_id")
  name                      String
  slug                      String
  order                     Int                  @default(0)
  description               String?
  postRegistrationMessage   String?              @map("post_registration_message")
  linkPostSubscription      String?              @map("link_post_subscription")
  requireImageAuthorization Boolean              @default(false) @map("require_image_authorization")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  event                     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields                    FormField[]
  responses                 FormResponse[]
  automationRuleForms       AutomationRuleForm[]
  /// Inscritos que nasceram deste formulário (imutável desde a criação).
  originOfRegistrations     Registration[]

  @@unique([eventId, slug])
  @@map("forms")
  @@schema("SED")
}

model EventCollaborator {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  profileId String    @map("profile_id")
  role      EventRole @default(invited)
  createdAt DateTime  @default(now()) @map("created_at")
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([eventId, profileId])
  @@index([profileId])
  @@map("event_collaborators")
  @@schema("SED")
}

model FormField {
  id        String    @id @default(uuid())
  formId    String    @map("form_id")
  label     String
  type      FieldType
  required  Boolean   @default(true)
  options   Json?
  order     Int       @default(0)
  isFixed   Boolean   @default(false) @map("is_fixed")
  createdAt DateTime  @default(now()) @map("created_at")
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
  @@schema("SED")
}

/// Resposta de um inscrito a um formulário — a junção N formulários × N pessoas.
/// Uma resposta por (form, inscrito): reenviar sobrescreve, como o pós-evento já fazia.
model FormResponse {
  id             String       @id @default(uuid())
  formId         String       @map("form_id")
  eventId        String       @map("event_id")
  registrationId String       @map("registration_id")
  answers        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  form           Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([formId, registrationId])
  @@index([eventId])
  @@index([registrationId])
  @@map("form_responses")
  @@schema("SED")
}

model Registration {
  id                 String           @id @default(uuid())
  eventId            String           @map("event_id")
  status             FunnelStatus     @default(pending)
  answers            Json
  name               String
  email              String
  phone              String
  imageAuthorization Boolean          @default(false) @map("image_authorization")
  attended           Boolean          @default(false)
  /// Resultado do envio ao Pipedrive. Antes vivia em user_subscriptions, tabela
  /// removida do código em 2026-08-17.
  pipedriveStatus    PipedriveStatus? @map("pipedrive_status")
  /// Formulário que criou a inscrição. Imutável desde a criação — FormResponse é
  /// N-N e não serve pra isso depois da segunda resposta. Nulo para inscritos
  /// criados antes desta coluna (sem backfill possível) ou direto pelo painel.
  originFormId       String?          @map("origin_form_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  event              Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originForm         Form?            @relation(fields: [originFormId], references: [id], onDelete: SetNull)
  outboxMessages     OutboxMessage[]
  messageLogs        MessageLog[]
  formResponses      FormResponse[]

  @@index([eventId, status])
  @@index([originFormId])
  @@map("registrations")
  @@schema("SED")
}

model MessageTemplate {
  id              String           @id @default(uuid())
  ownerId         String           @map("owner_id")
  name            String
  channel         MessageChannel
  subject         String?
  body            String
  layoutConfig    Json?            @map("layout_config")
  styleKey        String?          @map("style_key")
  eventId         String?          @map("event_id")
  folderId        String?          @map("folder_id")
  order           Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  folder          Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  automationRules AutomationRule[]
  outboxMessages  OutboxMessage[]

  @@index([ownerId])
  @@index([eventId])
  @@index([folderId])
  @@map("message_templates")
  @@schema("SED")
}

model AutomationRule {
  id           String               @id @default(uuid())
  eventId      String               @map("event_id")
  templateId   String               @map("template_id")
  trigger      AutomationTrigger
  delayMinutes Int?                 @map("delay_minutes")
  cron         String?
  timezone     String?
  /// Instante do disparo único (trigger on_date), em UTC. `timezone` guarda o fuso em que foi marcado.
  sendAt       DateTime?            @map("send_at")
  /// Marcado no claim do sweeper: regra de data já disparada não dispara de novo.
  firedAt      DateTime?            @map("fired_at")
  active       Boolean              @default(true)
  folderId     String?              @map("folder_id")
  order        Int                  @default(0)
  createdAt    DateTime             @default(now()) @map("created_at")
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template     MessageTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  folder       Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Escopo por formulário: obrigatório em on_form_submitted, opcional em on_registration.
  /// Vazio = todos os formulários do evento (dinâmico).
  forms        AutomationRuleForm[]

  @@index([eventId, trigger, active])
  @@index([folderId])
  @@map("automation_rules")
  @@schema("SED")
}

/// Junção regra↔formulário (N formulários por regra). Linha ausente para uma
/// regra = "todos os formulários", inclusive os criados depois.
model AutomationRuleForm {
  ruleId String         @map("rule_id")
  formId String         @map("form_id")
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  form   Form           @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([ruleId, formId])
  @@index([formId])
  @@map("automation_rule_forms")
  @@schema("SED")
}

model OutboxMessage {
  id                String           @id @default(uuid())
  eventId           String?          @map("event_id")
  ownerId           String?          @map("owner_id")
  registrationId    String?          @map("registration_id")
  templateId        String?          @map("template_id")
  trigger           String
  dedupKey          String           @unique @map("dedup_key")
  channel           MessageChannel
  recipient         String
  instancia         String?
  renderedBody      String           @map("rendered_body")
  renderedSubject   String?          @map("rendered_subject")
  inviteConfig      Json?            @map("invite_config")
  status            OutboxStatus     @default(pending)
  attempts          Int              @default(0)
  sentParts         Int              @default(0) @map("sent_parts")
  attachments       Json?            @map("attachments")
  sentAttachments   Int              @default(0) @map("sent_attachments")
  errorMessage      String?          @map("error_message")
  providerMessageId String?          @map("provider_message_id")
  deliveredAt       DateTime?        @map("delivered_at")
  readAt            DateTime?        @map("read_at")
  processedAt       DateTime?        @map("processed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  registration      Registration?    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template          MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  event             Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner             Profile?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([instancia, status])
  @@index([status, createdAt])
  @@index([eventId])
  @@index([ownerId])
  @@index([providerMessageId])
  @@map("outbox_messages")
  @@schema("SED")
}

model MessageLog {
  id                String         @id @default(uuid())
  eventId           String?        @map("event_id")
  ownerId           String?        @map("owner_id")
  registrationId    String?        @map("registration_id")
  channel           MessageChannel
  recipient         String
  body              String
  status            String
  errorMessage      String?        @map("error_message")
  providerMessageId String?        @map("provider_message_id")
  deliveredAt       DateTime?      @map("delivered_at")
  readAt            DateTime?      @map("read_at")
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  registration      Registration?  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event             Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner             Profile?       @relation("MessageLogOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([eventId])
  @@index([ownerId])
  @@index([providerMessageId])
  @@map("message_logs")
  @@schema("SED")
}
